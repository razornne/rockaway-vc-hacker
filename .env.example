# Copy to .env and fill in. .env is git-ignored.

# LLM (OpenAI). Model names are checked with `dd models`.
OPENAI_API_KEY=
LLM_MODEL_EXTRACT=gpt-5-nano
LLM_MODEL_ANALYZE=gpt-5-mini
# Hard spending cap for all LLM calls recorded in the local DB (USD)
LLM_BUDGET_USD=2.50
# Prices per 1M tokens "model=input,output;..." — verify at openai.com/api/pricing
LLM_PRICES=gpt-5-nano=0.05,0.40;gpt-5-mini=0.25,2.00

# Optional sources
GITHUB_TOKEN=
HLIDAC_TOKEN=
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=

# Storage (relative to project root)
DD_HOME=.dd
# Optional: Claude models for comparison runs (dd analyze ID --model claude-sonnet-5-5 --compare).
# Add claude prices to LLM_PRICES, e.g. ;claude-sonnet-5-5=2.00,10.00;claude-haiku-5-5=0.10,0.50
ANTHROPIC_API_KEY=
ANTHROPIC_BUDGET_USD=0.40
